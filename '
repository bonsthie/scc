#ifndef SCC_OPTION_ARGS_H
#define SCC_OPTION_ARGS_H

#include <string>
#include <unordered_map>
#include <variant>
#include <vector>

struct Arg {
    std::vector<std::string> value;
    bool                     isSingleValueArg;
    bool                     claim = false;
};

template <typename OptIndex> //
struct Args {
    // all the possible type for the config

    std::unordered_map<OptIndex, Arg> ValMap;

    bool hasArg(OptIndex index) { return getArg(index) != nullptr; }
    Arg *getArg(OptIndex index) {}
};

#endif // SCC_OPTION_ARGS_H
